    "scripts": [
      {
        "$schema": "https://schemas.meshmakers.cloud/ck-migration.schema.json",
        "sourceVersion": "1.2.0",
        "targetVersion": "2.0.0",
        "description": "Migration from Industry.Logistics 1.2.0 to 2.0.0.\n\nRenames \u0027ExportDate\u0027 to \u0027ExportDay\u0027 on all ExportRun entities. The value is unchanged:\na calendar day (yyyy-MM-dd) in the delivery time zone, used as the bucket key of the\ndelivery-dedup marker. Every other Date attribute in this kit (OrderDate, DeliveryDate,\nShipmentDate) is a DateTime, so the old name read like a timestamp.\n\nA rename is structurally a removal plus an addition, which is why the model takes a\nmajor bump. The RenameAttribute transform carries the stored value over to the new\nattribute name, so an existing marker keeps gating its day across the upgrade.\n\nTenants still installed on 1.1.0 reach this script through the engine\u0027s start-gap\nauto-bridge (1.1.0 -\u003E 1.2.0 is a schema-only no-op); no separate 1.1.0 entry is needed.\n\nBreaking changes:\n- Code, queries and pipeline configurations reading \u0027ExportDate\u0027 on ExportRun must read\n  \u0027ExportDay\u0027.\n",
        "steps": [
          {
            "stepId": "rename-exportdate-to-exportday",
            "description": "Rename ExportDate attribute to ExportDay on ExportRun entities",
            "action": "Transform",
            "target": {
              "ckTypeId": "Industry.Logistics/ExportRun",
              "blueprintSourceOnly": false
            },
            "transform": {
              "type": "RenameAttribute",
              "targetAttribute": "ExportDay",
              "sourceAttribute": "ExportDate"
            },
            "onConflict": "Skip",
            "continueOnError": false
          }
        ],
        "postValidations": [
          {
            "validationId": "every-exportrun-has-exportday",
            "description": "Ensure every ExportRun entity carries the ExportDay attribute",
            "type": "NoEntitiesOfType",
            "target": {
              "ckTypeId": "Industry.Logistics/ExportRun",
              "filter": {
                "attribute": "ExportDay",
                "operator": "NotExists"
              },
              "blueprintSourceOnly": false
            },
            "severity": "Warning"
          }
        ]
      },
      {
        "$schema": "https://schemas.meshmakers.cloud/ck-migration.schema.json",
        "sourceVersion": "2.2.0",
        "targetVersion": "3.0.0",
        "description": "Migration from Industry.Logistics 2.x to 3.0.0 (AB#5399). Intentionally empty.\n\n3.0.0 is a major only because the version gate classifies the new UniqueNotDeleted\nindexes on (Source, OrderNumber) and (Source, ExportKind, ExportDay) as a major change.\nEverything else is additive, and the two removed assignments (Order.DeliveryAddress,\nOrderItem.UnitPriceNet) are written and read by no adapter. The data needs no transform:\nexisting records keep Source = Unknown until an adapter states it, and are relabelled per\ntenant by the operator (see the AB#5399 commit message).\n\nWhy the script exists at all (AB#4924 / G3): the CK engine now refuses the post-chain\nschema-only bridge across a major version (CkMigrationMajorVersionGuard). Before this entry\nthe chain ended at 2.0.0, so every tenant on Industry.Logistics 2.x would have been refused\non its upgrade to 3.x. This empty step is the explicit statement that 2.x -\u003E 3.0.0 is\nschema-only, which the guard requires instead of assuming it.\n",
        "steps": []
      },
      {
        "$schema": "https://schemas.meshmakers.cloud/ck-migration.schema.json",
        "sourceVersion": "2.2.0",
        "targetVersion": "3.0.0",
        "description": "Migration from Industry.Logistics 2.x to 3.0.0 (AB#5399). Intentionally empty.\n\n3.0.0 is a major only because the version gate classifies the new UniqueNotDeleted\nindexes on (Source, OrderNumber) and (Source, ExportKind, ExportDay) as a major change.\nEverything else is additive, and the two removed assignments (Order.DeliveryAddress,\nOrderItem.UnitPriceNet) are written and read by no adapter. The data needs no transform:\nexisting records keep Source = Unknown until an adapter states it, and are relabelled per\ntenant by the operator (see the AB#5399 commit message).\n\nWhy the script exists at all (AB#4924 / G3): the CK engine now refuses the post-chain\nschema-only bridge across a major version (CkMigrationMajorVersionGuard). Before this entry\nthe chain ended at 2.0.0, so every tenant on Industry.Logistics 2.x would have been refused\non its upgrade to 3.x. This empty step is the explicit statement that 2.x -\u003E 3.0.0 is\nschema-only, which the guard requires instead of assuming it.\n",
        "steps": []
      },
      {
        "$schema": "https://schemas.meshmakers.cloud/ck-migration.schema.json",
        "sourceVersion": "2.2.0",
        "targetVersion": "3.0.0",
        "description": "Migration from Industry.Logistics 2.x to 3.0.0 (AB#5399). Intentionally empty.\n\n3.0.0 is a major only because the version gate classifies the new UniqueNotDeleted\nindexes on (Source, OrderNumber) and (Source, ExportKind, ExportDay) as a major change.\nEverything else is additive, and the two removed assignments (Order.DeliveryAddress,\nOrderItem.UnitPriceNet) are written and read by no adapter. The data needs no transform:\nexisting records keep Source = Unknown until an adapter states it, and are relabelled per\ntenant by the operator (see the AB#5399 commit message).\n\nWhy the script exists at all (AB#4924 / G3): the CK engine now refuses the post-chain\nschema-only bridge across a major version (CkMigrationMajorVersionGuard). Before this entry\nthe chain ended at 2.0.0, so every tenant on Industry.Logistics 2.x would have been refused\non its upgrade to 3.x. This empty step is the explicit statement that 2.x -\u003E 3.0.0 is\nschema-only, which the guard requires instead of assuming it.\n",
        "steps": []
      }
