    {
      "id": "CreatedBy-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "Display name or subject id of the consultant who created the link"
    },
    {
      "id": "DetectedAt-1",
      "valueType": "DateTime",
      "isRuntimeState": false,
      "description": "UTC instant the detection run produced this result"
    },
    {
      "id": "DetectedFormat-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "The CSV dialect / grid-operator format the frontend parser detected"
    },
    {
      "id": "DeviceKind-1",
      "valueType": "Enum",
      "valueCkEnumId": "SmartMeterInsights-1.2.0/DeviceKind-1",
      "isRuntimeState": false,
      "description": "The device kind this detection result is about"
    },
    {
      "id": "DuplicateCount-1",
      "valueType": "Int",
      "defaultValues": [
        "0"
      ],
      "isRuntimeState": false,
      "description": "Number of duplicate readings the frontend removed before upload"
    },
    {
      "id": "EstimatedYearlySavingEur-1",
      "valueType": "Double",
      "isRuntimeState": false,
      "description": "Estimated yearly saving in EUR derived from deterministic consumption facts"
    },
    {
      "id": "EvidenceFrom-1",
      "valueType": "DateTime",
      "isRuntimeState": false,
      "description": "Start (UTC) of the data window the heuristic evaluated"
    },
    {
      "id": "EvidenceSummary-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "Human-readable German explanation of the rule that fired and its measured evidence"
    },
    {
      "id": "EvidenceTo-1",
      "valueType": "DateTime",
      "isRuntimeState": false,
      "description": "End (UTC, exclusive) of the data window the heuristic evaluated"
    },
    {
      "id": "ExpiresAt-1",
      "valueType": "DateTime",
      "isRuntimeState": false,
      "description": "UTC instant after which the link is rejected (unset = never expires)"
    },
    {
      "id": "FileName-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "Name of the uploaded CSV file the readings were parsed from"
    },
    {
      "id": "GapList-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "JSON array of gap ranges [{\u0022from\u0022:\u0022...\u0022,\u0022to\u0022:\u0022...\u0022}] detected by the frontend parser"
    },
    {
      "id": "LastAccessAt-1",
      "valueType": "DateTime",
      "isRuntimeState": false,
      "description": "UTC instant of the most recent successful read"
    },
    {
      "id": "Message-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "Personal message shown to the customer on the shared dashboard"
    },
    {
      "id": "Notes-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "Free-form consultant notes about the customer"
    },
    {
      "id": "PeriodFrom-1",
      "valueType": "DateTime",
      "isRuntimeState": false,
      "description": "Start (UTC) of the time range covered by the imported readings"
    },
    {
      "id": "PeriodTo-1",
      "valueType": "DateTime",
      "isRuntimeState": false,
      "description": "End (UTC) of the time range covered by the imported readings"
    },
    {
      "id": "RecommendationState-1",
      "valueType": "Enum",
      "valueCkEnumId": "SmartMeterInsights-1.2.0/RecommendationState-1",
      "isRuntimeState": false,
      "description": "Draft (consultant only) or Published (visible on the shared view)"
