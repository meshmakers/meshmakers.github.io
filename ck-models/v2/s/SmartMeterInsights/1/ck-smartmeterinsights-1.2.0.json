    },
    {
      "id": "ShowDashboard-1",
      "valueType": "Boolean",
      "isRuntimeState": false,
      "description": "Section flag: consumption dashboard visible on the shared view"
    },
    {
      "id": "ShowDevices-1",
      "valueType": "Boolean",
      "isRuntimeState": false,
      "description": "Section flag: device breakdown visible on the shared view"
    },
    {
      "id": "ShowGridFees2027-1",
      "valueType": "Boolean",
      "defaultValues": [
        "false"
      ],
      "isRuntimeState": false,
      "description": "Section flag: Netzentgelt 2027 comparison (capacity-based grid fees, draft SNE-G-V) visible on the shared view (AB#5246)"
    },
    {
      "id": "ShowQualityDetails-1",
      "valueType": "Boolean",
      "isRuntimeState": false,
      "description": "Section flag: data-quality details visible on the shared view"
    },
    {
      "id": "ShowRawExport-1",
      "valueType": "Boolean",
      "isRuntimeState": false,
      "description": "Section flag: raw data export available on the shared view"
    },
    {
      "id": "ShowRecommendations-1",
      "valueType": "Boolean",
      "isRuntimeState": false,
      "description": "Section flag: recommendations visible on the shared view"
    },
    {
      "id": "SortOrder-1",
      "valueType": "Int",
      "defaultValues": [
        "0"
      ],
      "isRuntimeState": false,
      "description": "Display position on the customer view (ascending; consultant-reorderable)"
    },
    {
      "id": "Source-1",
      "valueType": "Enum",
      "valueCkEnumId": "SmartMeterInsights-1.2.0/RecommendationSource-1",
      "isRuntimeState": false,
      "description": "Provenance of the text (Heuristic template, Ai generated, Manual)"
    },
    {
      "id": "State-1",
      "valueType": "Enum",
      "valueCkEnumId": "SmartMeterInsights-1.2.0/ImportState-1",
      "isRuntimeState": false,
      "description": "Lifecycle state of the import session"
    },
    {
      "id": "Text-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "German body text of the recommendation (consultant-editable)"
    },
    {
      "id": "Title-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "Short German headline of the recommendation (consultant-editable)"
    },
    {
      "id": "Token-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "Opaque URL token of the share link (unique per tenant)"
    },
    {
      "id": "ValueCount-1",
      "valueType": "Int",
      "defaultValues": [
        "0"
      ],
      "isRuntimeState": false,
      "description": "Number of 15-minute readings persisted by this import"
    }
  ],
  "records": [],
  "enums": [
    {
      "enumId": "DetectionConfidence-1",
      "useFlags": false,
      "isExtensible": false,
      "values": [
        {
          "key": 0,
          "name": "NotDetected",
          "description": "The heuristic found no evidence for the device (honest default)",
          "isExtension": false
        },
        {
          "key": 1,
          "name": "Uncertain",
          "description": "Weak evidence \u2014 the pattern is present but ambiguous",
          "isExtension": false
        },
        {
          "key": 2,
          "name": "Likely",
          "description": "Clear evidence for the device",
          "isExtension": false
        },
        {
          "key": 3,
          "name": "VeryLikely",
          "description": "Strong, multi-signal evidence for the device",
          "isExtension": false
        }
      ],
      "description": "Confidence level of a device detection result (UI: sehr wahrscheinlich / wahrscheinlich / unsicher / nicht erkannt)"
    },
    {
      "enumId": "DeviceKind-1",
      "useFlags": false,
      "isExtensible": false,
      "values": [
        {
          "key": 0,
          "name": "HeatPump",
          "description": "Heat pump (winter/summer consumption ratio \u002B cold-season base elevation)",
          "isExtension": false
        },
        {
          "key": 1,
          "name": "EvCharging",
          "description": "Electric-vehicle charging (recurring multi-kW night blocks)",
          "isExtension": false
        },
        {
          "key": 2,
          "name": "Pv",
          "description": "Photovoltaic system (2.8.x production series or systematic midday consumption dips)",
          "isExtension": false
        },
        {
          "key": 3,
          "name": "ElectricWaterHeater",
          "description": "Electric water heater / boiler (fixed nightly high-power windows, moderate power)",
          "isExtension": false
        },
        {
          "key": 4,
          "name": "NightStorage",
          "description": "Night storage heating (fixed nightly high-power windows, high power, winter-heavy)",
          "isExtension": false
        }
      ],
      "description": "Kind of electrical device/consumer a detection heuristic looks for (AB#5245)"
    },
    {
      "enumId": "ImportState-1",
      "useFlags": false,
      "isExtensible": false,
      "values": [
        {
          "key": 0,
          "name": "Pending",
          "description": "The import has been created but not all values are persisted yet",
          "isExtension": false
        },
        {
          "key": 1,
          "name": "Completed",
          "description": "All readings of the import were persisted successfully",
          "isExtension": false
        },
        {
          "key": 2,
          "name": "Failed",
          "description": "The import was aborted; the session exists for diagnostics only",
          "isExtension": false
        }
      ],
      "description": "State of a smart-meter CSV import session"
    },
    {
      "enumId": "RecommendationSource-1",
      "useFlags": false,
      "isExtensible": false,
      "values": [
        {
          "key": 0,
          "name": "Heuristic",
          "description": "Deterministic template text generated from detection \u002B consumption facts",
          "isExtension": false
        },
        {
          "key": 1,
          "name": "Ai",
          "description": "Text generated via the platform AI path (AnthropicAiQuery pipeline node)",
          "isExtension": false
        },
        {
          "key": 2,
          "name": "Manual",
          "description": "Written or substantially edited by the consultant",
          "isExtension": false
        }
      ],
      "description": "How a recommendation\u0027s text was produced (AB#5245)"
    },
    {
      "enumId": "RecommendationState-1",
      "useFlags": false,
      "isExtensible": false,
      "values": [
        {
          "key": 0,
          "name": "Draft",
          "description": "Visible to the consultant only; editable",
          "isExtension": false
        },
        {
          "key": 1,
          "name": "Published",
          "description": "Visible on the shared customer view (ShowRecommendations flag)",
          "isExtension": false
        }
      ],
      "description": "Publication state of a recommendation \u2014 only Published ones reach the end customer"
    }
  ],
  "modelId": "SmartMeterInsights-1.2.0",
  "description": "Smart Meter Insights domain model (Epic AB#4059): end customers of an energy consulting firm, CSV import sessions for 15-minute smart-meter readings, revocable share links for the public read-only dashboard, device detection results and consultant-editable saving recommendations (AB#5245). 1.2.0 adds the ShareLink section flag ShowGridFees2027 for the capacity-based grid-fee analysis (AB#5246). Time-series values reuse Basic.Energy/EnergyMeasurement (one anchor per metering point and OBIS code, slots in the stream-data archive)."
}