    {
      "id": "RegistrationCaptchaSecret-1",
      "valueType": "String",
      "isRuntimeState": true,
      "description": "Cloudflare Turnstile secret key, read by the registration pipeline when it verifies a submitted CAPTCHA token. Empty means the endpoint refuses every application: the CAPTCHA is required and cannot be switched off"
    },
    {
      "id": "RegistrationConsentAccepted-1",
      "valueType": "Boolean",
      "isRuntimeState": false,
      "description": "Whether the applicant confirmed the consent clause. Stamped by the pipeline, not taken from the request body"
    },
    {
      "id": "RegistrationConsentVersion-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "Version of the consent text the applicant was shown, so a later change to the wording stays auditable"
    },
    {
      "id": "RegistrationContactPerson-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "The person to contact at an applying company (Ansprechpartner)"
    },
    {
      "id": "RegistrationDesignation-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "The applicant\u0027s own label for a declared metering point, so several can be told apart"
    },
    {
      "id": "RegistrationLanguage-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "Language the application was submitted in (de or en), so the confirmation reads the same way the form did"
    },
    {
      "id": "RegistrationNotificationRecipients-1",
      "valueType": "StringArray",
      "isRuntimeState": true,
      "description": "Addresses told that a membership application arrived. Empty means nobody is notified, which is what an unconfigured tenant gets rather than a failed send"
    },
    {
      "id": "RegistrationPostalCode-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "Postal code as typed on a membership application, before an operator has resolved it to a city"
    },
    {
      "id": "RegistrationRejectionReason-1",
      "valueType": "String",
      "isRuntimeState": false,
      "description": "Why an operator refused the application, in the operator\u0027s own words. Sent to the applicant verbatim in the refusal mail, so it is written for them to read"
    },
    {
      "id": "RegistrationSubmittedAt-1",
      "valueType": "DateTime",
      "isRuntimeState": false,
      "description": "When the application reached the endpoint. Stamped server-side"
    }
