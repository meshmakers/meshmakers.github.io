      "id": "RefreshToken-1",
      "valueType": "Secret",
      "ownership": "Secret",
      "isRuntimeState": true,
      "description": "Current OAuth refresh token. Tesla rotates refresh tokens \u2014 the fetcher pipeline reveals it with RevealSecret@1 and persists the newest one back on every run. Write the plaintext; reads only report whether it is set."
    },
    {
      "id": "TokenUrl-1",
      "valueType": "String",
      "isRuntimeState": true,
      "description": "OAuth token endpoint for server-to-server calls (https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token)."
    }
