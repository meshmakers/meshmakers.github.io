  "attributes": [
    {
      "id": "BaseUrl-1",
      "valueType": "String",
      "isRuntimeState": true,
      "description": "Base URL of the Tesla Fleet API for the account\u0027s region (EU: https://fleet-api.prd.eu.vn.cloud.tesla.com)."
    },
    {
      "id": "ClientId-1",
      "valueType": "String",
