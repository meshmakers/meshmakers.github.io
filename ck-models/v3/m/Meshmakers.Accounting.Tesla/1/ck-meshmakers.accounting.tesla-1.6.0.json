    },
    {
      "id": "ClientSecret-1",
      "valueType": "Secret",
      "ownership": "Secret",
      "isRuntimeState": true,
      "description": "Client secret of the Tesla developer app (not needed for the refresh-token grant, kept for completeness). Write the plaintext; reads only report whether it is set."
    },
    {
      "id": "PageSize-1",
      "valueType": "Int",
      "isRuntimeState": true,
      "description": "Number of most-recent charging sessions fetched per run (dedup drops already-staged invoices)."
