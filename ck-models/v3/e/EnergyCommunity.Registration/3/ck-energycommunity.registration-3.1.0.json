  "associationRoles": [
    {
      "id": "RegisteredCustomer-1",
      "inboundName": "Registration",
      "outboundName": "Customer",
      "inboundMultiplicity": "ZeroOrOne",
      "outboundMultiplicity": "ZeroOrOne",
      "description": "The customer an accepted membership application produced (AB#3717). ZeroOrOne on both ends: an application is pending until an operator accepts it, and a customer created by hand has no application behind it. Without it an accepted and a rejected application would be indistinguishable once both are archived."
    }
  ],
  "attributes": [
    {
      "id": "MemberRegistrationMeteringPoints-1",
      "valueType": "RecordArray",
      "valueCkRecordId": "EnergyCommunity.Registration-3.1.0/MemberRegistrationMeteringPoint-1",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "The metering points declared on a membership application"
    },
    {
      "id": "RegistrationAnnualConsumptionKwh-1",
      "valueType": "Double",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "Declared approximate annual consumption of a metering point, in kWh"
    },
    {
      "id": "RegistrationCapacityKwPeak-1",
      "valueType": "Double",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "Declared capacity of a generation plant, in kWpeak"
    },
    {
      "id": "RegistrationCaptchaSecret-1",
      "valueType": "Secret",
      "ownership": "Secret",
      "isRuntimeState": true,
      "description": "Cloudflare Turnstile secret key, read by the registration pipeline (RevealSecret@1) when it verifies a submitted CAPTCHA token. Stored encrypted; reads only report whether it is set. Not set means the endpoint refuses every application: the CAPTCHA is required and cannot be switched off"
    },
    {
      "id": "RegistrationCaptchaSiteKey-1",
      "valueType": "String",
      "ownership": "TenantOwned",
      "isRuntimeState": true,
      "description": "Cloudflare Turnstile site key of the community, the public half of the pair whose secret is CaptchaSecret. Not a secret: the anonymous registration page renders its widget with it. A Turnstile secret only verifies tokens issued for its own site key, so a community that stores its own secret stores its own site key too. Empty means the registration page uses the site key of the deployment"
    },
    {
      "id": "RegistrationConsentAccepted-1",
      "valueType": "Boolean",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "Whether the applicant confirmed the consent clause. Stamped by the pipeline, not taken from the request body"
    },
    {
      "id": "RegistrationConsentVersion-1",
      "valueType": "String",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "Version of the consent text the applicant was shown, so a later change to the wording stays auditable"
    },
    {
      "id": "RegistrationContactPerson-1",
      "valueType": "String",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "The person to contact at an applying company (Ansprechpartner)"
    },
    {
      "id": "RegistrationDesignation-1",
      "valueType": "String",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "The applicant\u0027s own label for a declared metering point, so several can be told apart"
    },
    {
      "id": "RegistrationLanguage-1",
      "valueType": "String",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "Language the application was submitted in (de or en), so the confirmation reads the same way the form did"
    },
    {
      "id": "RegistrationNotificationRecipients-1",
      "valueType": "StringArray",
      "isRuntimeState": true,
      "description": "Addresses told that a membership application arrived. Empty means nobody is notified, which is what an unconfigured tenant gets rather than a failed send"
    },
    {
      "id": "RegistrationPostalCode-1",
      "valueType": "String",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "Postal code as typed on a membership application, before an operator has resolved it to a city"
    },
    {
      "id": "RegistrationRejectionReason-1",
      "valueType": "String",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "Why an operator refused the application, in the operator\u0027s own words. Sent to the applicant verbatim in the refusal mail, so it is written for them to read"
    },
    {
      "id": "RegistrationSubmittedAt-1",
      "valueType": "DateTime",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "When the application reached the endpoint. Stamped server-side"
    }
  ],
