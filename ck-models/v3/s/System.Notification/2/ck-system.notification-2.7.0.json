    {
      "id": "ProcessedUntil-1",
      "valueType": "DateTime",
      "ownership": "TenantOwned",
      "isRuntimeState": true,
      "description": "The change time (rtChangedDateTime) up to which the query result was processed; the next run reads only rows changed after it, minus a five-minute overlap for late commits and clock skew; empty means from the beginning"
    },
    {
      "id": "QueryRtId-1",
      "valueType": "String",
      "ownership": "TenantOwned",
      "isRuntimeState": true,
      "description": "The query the delivery state was built with; when the subscription points at another query, the next run is a new start"
    },
    {
      "id": "RedirectAfterEmailInteractionUrl-1",
      "valueType": "String",
      "ownership": "TenantOwned",
      "isRuntimeState": true,
      "description": "Redirect after email interaction URL"
    },
    {
      "id": "RenderingType-1",
      "valueType": "Enum",
      "valueCkEnumId": "System.Notification-2.7.0/RenderingTypes-1",
      "ownership": "TenantOwned",
      "isRuntimeState": true,
      "description": "Defines the rendering type of the notification (Text, Html)"
    },
    {
      "id": "RunningSince-1",
      "valueType": "DateTime",
      "ownership": "RuntimeState",
      "isRuntimeState": true,
      "description": "Lease of a run in progress; another tick of the same preference is skipped while it is recent"
    },
    {
      "id": "SentRowAt-1",
      "valueType": "DateTime",
      "ownership": "TenantOwned",
      "isRuntimeState": true,
      "description": "When the row was mailed; the entry is dropped 30 days later"
    },
    {
      "id": "SentRowChangedAt-1",
      "valueType": "DateTime",
      "ownership": "TenantOwned",
      "isRuntimeState": true,
      "description": "The change time of the row when it was mailed; while it lies inside the overlap the next run reads, the entry is never dropped"
    },
    {
      "id": "SentRowRtId-1",
      "valueType": "String",
      "ownership": "TenantOwned",
      "isRuntimeState": true,
      "description": "The rtId of a row of the query result that was mailed"
    },
    {
      "id": "SentRows-1",
      "valueType": "RecordArray",
      "valueCkRecordId": "System.Notification-2.7.0/SentRow-1",
      "ownership": "TenantOwned",
      "isRuntimeState": true,
      "description": "The rows mailed to the user, so that they are not mailed again; an entry is kept while the next run could read its row again (changed inside the overlap) and otherwise for 30 days, at most the 10,000 most recent, so the size is bounded by the recent sends and not by the size of the query result"
    },
    {
      "id": "SkipExistingRows-1",
      "valueType": "Boolean",
      "defaultValues": [
        "true"
      ],
      "ownership": "TenantOwned",
      "isRuntimeState": true,
      "description": "Rows that already match the query when the preference starts (created or its subscription deployed, whichever is later) are not sent to its user"
    },
    {
      "id": "SubjectId-1",
      "valueType": "String",
      "ownership": "TenantOwned",
      "isRuntimeState": true,
      "description": "Subject id (token sub) of the Identity user the preference belongs to"
    },
    {
      "id": "SubjectTemplate-1",
      "valueType": "String",
      "ownership": "TenantOwned",
      "isRuntimeState": true,
      "description": "The subject of the event as a template"
    },
    {
      "id": "SubjectText-1",
      "valueType": "String",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "The subject text of the notification"
    },
    {
      "id": "TimeZone-1",
      "valueType": "String",
      "ownership": "TenantOwned",
      "isRuntimeState": true,
      "description": "IANA time zone (for example Europe/Vienna) the preference\u0027s cron expression is scheduled in, and that dates in its mails are shown in; empty means UTC"
    }
