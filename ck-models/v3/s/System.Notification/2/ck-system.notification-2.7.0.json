    {
      "id": "Message-1",
      "valueType": "String",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "The message of the event"
    },
    {
      "id": "NotificationType-1",
      "valueType": "Enum",
      "valueCkEnumId": "System.Notification-2.7.0/NotificationTypes-1",
      "ownership": "SeedOwned",
      "isRuntimeState": false,
      "description": "Defines the type of the notification (Email, SMS, Push)"
